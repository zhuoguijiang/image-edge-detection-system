+    //--------------------------------------------------------------------------
+    // Full-resolution camera pixel stream (64-bit CSI beats -> 1 pixel/clk)
+    //--------------------------------------------------------------------------
+    wire [7:0]  cam_pix_data;
+    wire        cam_pix_valid, cam_pix_de, cam_pix_hs, cam_pix_vs;
+    wire [10:0] cam_pix_x, cam_pix_y;
