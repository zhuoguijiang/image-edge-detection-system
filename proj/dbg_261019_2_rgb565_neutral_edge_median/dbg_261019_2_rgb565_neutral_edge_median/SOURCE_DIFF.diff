+    //--------------------------------------------------------------------------
+    // CSI packed stream -> frozen 640x480 pixel stream
+    //--------------------------------------------------------------------------
+    wire [7:0]  pix_r, pix_g, pix_b;
+    wire        pix_valid, pix_de, pix_hsync, pix_vsync;
+    wire [10:0] pix_x, pix_y, pix_hcnt, pix_y_act;
+    wire        line_late, capture_ovf;
