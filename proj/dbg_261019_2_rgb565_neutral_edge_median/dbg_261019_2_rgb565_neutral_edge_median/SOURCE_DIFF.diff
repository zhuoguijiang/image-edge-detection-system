+//==============================================================================
+// alg_top : A-group image pipeline behind the frozen pixel-stream interface.
+//
+//   RAW8 Bayer (BGGR)
+//     -> line_buffer_3x3 -> debayer      (RAW8 -> RGB888)
+//     -> grayscale                        (RGB888 -> Y8)
+//     -> line_buffer_3x3 -> median3x3     (3x3 median denoise)
+//     -> [CANNY] gaussian5x5              (5x5 Gaussian pre-smoothing)
+//     -> line_buffer_3x3 -> sobel         (grad = |Gx|+|Gy|, gx, gy)
+//     -> [CANNY] line_buffer_3x3(grad) -> canny_nms -> canny_hysteresis
+//        [SOBEL] nms3x3 -> edge_link3x3
+//     -> out_data = binary edge (0xFF / 0x00)
+//     -> out_gray = median-filtered Y8, delayed to the same cycle
+//
+// EDGE_FILTER selects the Sobel input (CANNY_EN=0 path):
+//   0 = raw grayscale
+//   1 = plain 3x3 median
+//   2 = adaptive median (only isolated outliers are replaced)
+//
+// CANNY_EN selects the full Canny chain (Gaussian -> Sobel -> NMS ->
+// double-threshold hysteresis) instead of the plain Sobel threshold path.
+// With CANNY_EN=1 the edge path always uses the Gaussian-smoothed grayscale,
+// so EDGE_FILTER is ignored; the median stage still runs to feed out_gray.
+//
+// Port list matches rtl/alg/alg_stub.v exactly, so it is a drop-in replacement.
+// de/hs/vs/x/y are delayed by LATENCY cycles so they stay aligned with data.
+//==============================================================================
+module alg_top #(
+    parameter WIDTH   = 640,
+    parameter X_BITS  = 11,
+    parameter Y_BITS  = 11,
+    parameter LATENCY = 12,   // 1(lb1)+1(debayer)+1(gray)+1(lb2)+3(median)+1(lb3)+4(sobel)
+    parameter EDGE_FILTER = 1,
+    parameter NMS_EN = 0,
+    parameter LINK_EN = 0,
+    parameter CANNY_EN = 0,  // 1 = Gaussian + NMS + hysteresis (Canny) edge path
+    parameter CANNY_PREMEDIAN = 0,
+    parameter CANNY_GAUSS3 = 0,
+    parameter CANNY_SCHARR = 0,
+    parameter CANNY_NMS_INTERP = 0
+)(
+    input  wire                clk,
+    input  wire                rst_n,
+
+    input  wire [7:0]          in_data,
+    input  wire                in_valid,
+    input  wire                in_de,
+    input  wire                in_hs,
+    input  wire                in_vs,
+    input  wire [X_BITS-1:0]   in_x,
+    input  wire [Y_BITS-1:0]   in_y,
+
+    input  wire [7:0]          threshold,
+
+    output wire [7:0]          out_data,
+    output wire [7:0]          out_gray,
+    output wire                out_valid,
+    output wire                out_de,
+    output wire                out_hs,
+    output wire                out_vs,
+    output wire [X_BITS-1:0]   out_x,
+    output wire [Y_BITS-1:0]   out_y
+);
+
+    localparam W = WIDTH;
+
+    // interface vsync is active-low; the line buffer reset is active-high
+    wire vs_act = ~in_vs;
+
+    //--------------------------------------------------------------------------
+    // stage 1 : 3x3 window + debayer  (RAW8 -> RGB888)
+    //--------------------------------------------------------------------------
+    wire [7:0] a00,a01,a02,a10,a11,a12,a20,a21,a22;
+    wire       a_valid;
+    wire [15:0] a_x, a_y;
+
+    line_buffer_3x3 #(.WIDTH(W), .DW(8)) u_lb1 (
+        .clk(clk), .rst_n(rst_n),
+        .din(in_data), .din_valid(in_valid), .din_vsync(vs_act),
+        .w00(a00), .w01(a01), .w02(a02),
+        .w10(a10), .w11(a11), .w12(a12),
+        .w20(a20), .w21(a21), .w22(a22),
+        .dout_valid(a_valid), .dout_x(a_x), .dout_y(a_y)
+    );
+
+    wire [7:0] rgb_r, rgb_g, rgb_b;
+    wire       rgb_valid;
+    debayer u_db (
+        .clk(clk), .rst_n(rst_n),
+        .w00(a00), .w01(a01), .w02(a02),
+        .w10(a10), .w11(a11), .w12(a12),
+        .w20(a20), .w21(a21), .w22(a22),
+        .in_valid(a_valid), .in_x(a_x), .in_y(a_y),
+        .r(rgb_r), .g(rgb_g), .b(rgb_b), .out_valid(rgb_valid)
+    );
+
+    //--------------------------------------------------------------------------
+    // stage 2 : grayscale
+    //--------------------------------------------------------------------------
+    wire [7:0] gray_y;
+    wire       gray_valid, gray_href, gray_vsync;
+    grayscale u_gray (
+        .clk(clk), .rst_n(rst_n),
+        .r(rgb_r), .g(rgb_g), .b(rgb_b),
+        .in_valid(rgb_valid), .in_href(1'b1), .in_vsync(1'b0),
+        .y(gray_y), .out_valid(gray_valid),
+        .out_href(gray_href), .out_vsync(gray_vsync)
+    );
+
+    //--------------------------------------------------------------------------
+    // stage 3 : 3x3 window + median filter   (always on: feeds out_gray)
+    //--------------------------------------------------------------------------
+    wire [7:0] b00,b01,b02,b10,b11,b12,b20,b21,b22;
+    wire       b_valid;
+    wire [15:0] b_x, b_y;
+
+    line_buffer_3x3 #(.WIDTH(W-2), .DW(8)) u_lb2 (
+        .clk(clk), .rst_n(rst_n),
+        .din(gray_y), .din_valid(gray_valid), .din_vsync(1'b0),
+        .w00(b00), .w01(b01), .w02(b02),
+        .w10(b10), .w11(b11), .w12(b12),
+        .w20(b20), .w21(b21), .w22(b22),
+        .dout_valid(b_valid), .dout_x(b_x), .dout_y(b_y)
+    );
+
+    wire [7:0] med_y, med_adaptive;
+    wire       med_valid;
+    median3x3 u_med (
+        .clk(clk), .rst_n(rst_n),
+        .w00(b00), .w01(b01), .w02(b02),
+        .w10(b10), .w11(b11), .w12(b12),
+        .w20(b20), .w21(b21), .w22(b22),
+        .in_valid(b_valid), .med(med_y), .med_adaptive(med_adaptive),
+        .out_valid(med_valid)
+    );
+
+    // Delay the median-filtered grayscale by the remaining lb3 + Sobel
+    // latency (1 + 4 = 5 cycles), so out_gray is aligned with out_data.
+    reg [7:0] gray_d1, gray_d2, gray_d3, gray_d4, gray_d5, gray_d6, gray_d7;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            gray_d1 <= 8'd0; gray_d2 <= 8'd0; gray_d3 <= 8'd0;
+            gray_d4 <= 8'd0; gray_d5 <= 8'd0; gray_d6 <= 8'd0; gray_d7 <= 8'd0;
+        end else begin
+            gray_d1 <= med_y;
+            gray_d2 <= gray_d1;
+            gray_d3 <= gray_d2;
+            gray_d4 <= gray_d3;
+            gray_d5 <= gray_d4;
+            gray_d6 <= gray_d5;
+            gray_d7 <= gray_d6;
+        end
+    end
+    assign out_gray = (LATENCY >= 14) ? gray_d7 :
+                      (LATENCY >= 13) ? gray_d6 : gray_d5;
+
+    // Align the unfiltered grayscale with med_y at the input of lb3:
+    // gray_y is 4 cycles earlier (lb2 + 3-stage median).
+    reg [7:0] gray_raw_d1, gray_raw_d2, gray_raw_d3, gray_raw_d4;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            gray_raw_d1 <= 8'd0; gray_raw_d2 <= 8'd0;
+            gray_raw_d3 <= 8'd0; gray_raw_d4 <= 8'd0;
+        end else begin
+            gray_raw_d1 <= gray_y;
+            gray_raw_d2 <= gray_raw_d1;
+            gray_raw_d3 <= gray_raw_d2;
+            gray_raw_d4 <= gray_raw_d3;
+        end
+    end
+    wire [7:0] edge_src = (EDGE_FILTER == 2) ? med_adaptive :
+                          (EDGE_FILTER == 1) ? med_y : gray_raw_d4;
+
+    //==========================================================================
+    // SOBEL EDGE PATH  (CANNY_EN = 0)
+    //==========================================================================
+    wire [7:0]  sob_path_data;
+    wire        sob_path_valid;
+    generate
+        if (!CANNY_EN) begin : g_sobel
+            //--------------------------------------------------------------------------
+            // stage 4 : 3x3 window + sobel
+            //--------------------------------------------------------------------------
+            wire [7:0] c00,c01,c02,c10,c11,c12,c20,c21,c22;
+            wire       c_valid;
+            wire [15:0] c_x, c_y;
+
+            line_buffer_3x3 #(.WIDTH(W-4), .DW(8)) u_lb3 (
+                .clk(clk), .rst_n(rst_n),
+                .din(edge_src), .din_valid(med_valid), .din_vsync(1'b0),
+                .w00(c00), .w01(c01), .w02(c02),
+                .w10(c10), .w11(c11), .w12(c12),
+                .w20(c20), .w21(c21), .w22(c22),
+                .dout_valid(c_valid), .dout_x(c_x), .dout_y(c_y)
+            );
+
+            wire [11:0] grad;
+            wire        sob_valid, sob_edge;
+            wire signed [10:0] sob_gx, sob_gy;
+            sobel u_sob (
+                .clk(clk), .rst_n(rst_n),
+                .w00(c00), .w01(c01), .w02(c02),
+                .w10(c10), .w11(c11), .w12(c12),
+                .w20(c20), .w21(c21), .w22(c22),
+                .in_valid(c_valid), .threshold({4'b0000, threshold}),
+                .grad(grad), .gx(sob_gx), .gy(sob_gy),
+                .edge_out(sob_edge), .out_valid(sob_valid)
+            );
+
+            // Optional NMS + local hysteresis.  The gradient-magnitude line buffer
+            // adds one cycle, so the top level instantiates this path with LATENCY=13.
+            wire [11:0] nms_g00, nms_g01, nms_g02, nms_g10, nms_g11, nms_g12,
+                        nms_g20, nms_g21, nms_g22;
+            wire        nms_g_valid, nms_edge, nms_valid;
+            reg signed [10:0] nms_gx_d1, nms_gy_d1;
+            wire        link_edge, link_valid;
+
+            if (NMS_EN) begin : g_nms
+                line_buffer_3x3 #(.WIDTH(W-4), .DW(12)) u_lbg (
+                    .clk(clk), .rst_n(rst_n),
+                    .din(grad), .din_valid(sob_valid), .din_vsync(1'b0),
+                    .w00(nms_g00), .w01(nms_g01), .w02(nms_g02),
+                    .w10(nms_g10), .w11(nms_g11), .w12(nms_g12),
+                    .w20(nms_g20), .w21(nms_g21), .w22(nms_g22),
+                    .dout_valid(nms_g_valid), .dout_x(), .dout_y()
+                );
+
+                always @(posedge clk or negedge rst_n) begin
+                    if (!rst_n) begin
+                        nms_gx_d1 <= 11'sd0;
+                        nms_gy_d1 <= 11'sd0;
+                    end else begin
+                        nms_gx_d1 <= sob_gx;
+                        nms_gy_d1 <= sob_gy;
+                    end
+                end
+
+                nms3x3 u_nms (
+                    .clk(clk), .rst_n(rst_n),
+                    .g00(nms_g00), .g01(nms_g01), .g02(nms_g02),
+                    .g10(nms_g10), .g11(nms_g11), .g12(nms_g12),
+                    .g20(nms_g20), .g21(nms_g21), .g22(nms_g22),
+                    .gx(nms_gx_d1), .gy(nms_gy_d1),
+                    .in_valid(nms_g_valid),
+                    .high_thr(threshold), .low_thr(threshold >> 1),
+                    .edge_out(nms_edge), .out_valid(nms_valid)
+                );
+
+                if (LINK_EN) begin : g_link
+                    edge_link3x3 #(.WIDTH(W-4)) u_link (
+                        .clk(clk), .rst_n(rst_n),
+                        .in_edge(nms_edge), .in_valid(nms_valid),
+                        .gx(nms_gx_d1), .gy(nms_gy_d1),
+                        .out_edge(link_edge), .out_valid(link_valid)
+                    );
+                end else begin : g_no_link
+                    assign link_edge  = 1'b0;
+                    assign link_valid = 1'b0;
+                end
+            end else begin : g_no_nms
+                assign nms_g00 = 12'd0; assign nms_g01 = 12'd0; assign nms_g02 = 12'd0;
+                assign nms_g10 = 12'd0; assign nms_g11 = 12'd0; assign nms_g12 = 12'd0;
+                assign nms_g20 = 12'd0; assign nms_g21 = 12'd0; assign nms_g22 = 12'd0;
+                assign nms_g_valid = 1'b0;
+                assign nms_edge  = 1'b0;
+                assign nms_valid = 1'b0;
+                assign link_edge  = 1'b0;
+                assign link_valid = 1'b0;
+                always @(posedge clk or negedge rst_n) begin
+                    if (!rst_n) begin
+                        nms_gx_d1 <= 11'sd0;
+                        nms_gy_d1 <= 11'sd0;
+                    end else begin
+                        nms_gx_d1 <= sob_gx;
+                        nms_gy_d1 <= sob_gy;
+                    end
+                end
+            end
+
+            assign sob_path_data = LINK_EN
+                                 ? ((link_valid && link_edge) ? 8'hFF : 8'h00)
+                                 : (NMS_EN
+                                    ? ((nms_valid && nms_edge) ? 8'hFF : 8'h00)
+                                    : ((sob_valid && sob_edge) ? 8'hFF : 8'h00));
+            assign sob_path_valid = LINK_EN ? link_valid : (NMS_EN ? nms_valid : sob_valid);
+        end else begin : g_no_sobel
+            assign sob_path_data  = 8'h00;
+            assign sob_path_valid = 1'b0;
+        end
+    endgenerate
+
+    //==========================================================================
+    // CANNY EDGE PATH  (CANNY_EN = 1)
+    //   grayscale -> gaussian5x5 -> 3x3 sobel -> NMS -> hysteresis -> link
+    //   Total latency: 1(lb1)+1(debayer)+1(gray)+2(gauss)+1(lb3)+4(sobel)
+    //                  +1(lbg)+0(nms)+1(hyst)+1(link) = 13 cycles.
+    //==========================================================================
+    wire [7:0]  canny_path_data;
+    wire        canny_path_valid;
+    generate
+        if (CANNY_EN) begin : g_canny
+            localparam CANNY_SRC_W  = CANNY_PREMEDIAN ? (W - 4) : (W - 2);
+            localparam GAUSS5_OUT_W = CANNY_SRC_W - 4;
+            localparam LB3_IN_W     = GAUSS5_OUT_W - (CANNY_GAUSS3 ? 2 : 0);
+            localparam GRAD_LB_W    = LB3_IN_W - 2;
+            localparam HYST_W       = GRAD_LB_W - 2;
+            localparam LINK_W       = HYST_W - 2;
+            // Frame vsync follows either the raw grayscale path (3 stages) or
+            // the adaptive-median path (+lb2 and three median stages).
+            reg [6:0] vs_d;
+            always @(posedge clk or negedge rst_n) begin
+                if (!rst_n) vs_d <= 7'd0;
+                else         vs_d <= {vs_d[5:0], vs_act};
+            end
+            wire gauss_vsync = CANNY_PREMEDIAN ? vs_d[6] : vs_d[2];
+            wire [7:0] canny_src = CANNY_PREMEDIAN ? med_adaptive : gray_y;
+            wire       canny_src_valid = CANNY_PREMEDIAN ? med_valid : gray_valid;
+
+            wire [7:0] gauss_y;
+            wire       gauss_valid;
+            gaussian5x5 #(.WIDTH(CANNY_SRC_W), .DW(8)) u_gauss (
+                .clk(clk), .rst_n(rst_n),
+                .din(canny_src), .din_valid(canny_src_valid), .din_vsync(gauss_vsync),
+                .dout(gauss_y), .dout_valid(gauss_valid)
+            );
+
+            wire [7:0] gauss3_y;
+            wire       gauss3_valid;
+            if (CANNY_GAUSS3) begin : g_smooth3
+                gaussian3x3 #(.WIDTH(GAUSS5_OUT_W), .DW(8)) u_gauss3 (
+                    .clk(clk), .rst_n(rst_n),
+                    .din(gauss_y), .din_valid(gauss_valid), .din_vsync(1'b0),
+                    .dout(gauss3_y), .dout_valid(gauss3_valid)
+                );
+            end else begin : g_no_smooth3
+                assign gauss3_y = gauss_y;
+                assign gauss3_valid = gauss_valid;
+            end
+
+            wire [7:0] edge_smooth_y = CANNY_GAUSS3 ? gauss3_y : gauss_y;
+            wire       edge_smooth_valid = CANNY_GAUSS3 ? gauss3_valid : gauss_valid;
+
+            wire [7:0] c00,c01,c02,c10,c11,c12,c20,c21,c22;
+            wire       c_valid;
+            wire [15:0] c_x, c_y;
+
+            line_buffer_3x3 #(.WIDTH(LB3_IN_W), .DW(8)) u_lb3c (
+                .clk(clk), .rst_n(rst_n),
+                .din(edge_smooth_y), .din_valid(edge_smooth_valid), .din_vsync(1'b0),
+                .w00(c00), .w01(c01), .w02(c02),
+                .w10(c10), .w11(c11), .w12(c12),
+                .w20(c20), .w21(c21), .w22(c22),
+                .dout_valid(c_valid), .dout_x(c_x), .dout_y(c_y)
+            );
+
+            wire [11:0] c_grad;
+            wire        c_sob_valid, c_sob_edge;
+            wire signed [10:0] c_gx, c_gy;
+            if (CANNY_SCHARR) begin : g_scharr_sob
+                scharr u_sob_c (
+                    .clk(clk), .rst_n(rst_n),
+                    .w00(c00), .w01(c01), .w02(c02),
+                    .w10(c10), .w11(c11), .w12(c12),
+                    .w20(c20), .w21(c21), .w22(c22),
+                    .in_valid(c_valid), .threshold({4'b0000, threshold}),
+                    .grad(c_grad), .gx(c_gx), .gy(c_gy),
+                    .edge_out(c_sob_edge), .out_valid(c_sob_valid)
+                );
+            end else begin : g_sobel_sob
+                sobel u_sob_c (
+                    .clk(clk), .rst_n(rst_n),
+                    .w00(c00), .w01(c01), .w02(c02),
+                    .w10(c10), .w11(c11), .w12(c12),
+                    .w20(c20), .w21(c21), .w22(c22),
+                    .in_valid(c_valid), .threshold({4'b0000, threshold}),
+                    .grad(c_grad), .gx(c_gx), .gy(c_gy),
+                    .edge_out(c_sob_edge), .out_valid(c_sob_valid)
+                );
+            end
+
+            // gradient-magnitude 3x3 window for NMS (+1 cycle)
+            wire [11:0] n00,n01,n02,n10,n11,n12,n20,n21,n22;
+            wire        n_valid;
+            line_buffer_3x3 #(.WIDTH(GRAD_LB_W), .DW(12)) u_lbgc (
+                .clk(clk), .rst_n(rst_n),
+                .din(c_grad), .din_valid(c_sob_valid), .din_vsync(1'b0),
+                .w00(n00), .w01(n01), .w02(n02),
+                .w10(n10), .w11(n11), .w12(n12),
+                .w20(n20), .w21(n21), .w22(n22),
+                .dout_valid(n_valid), .dout_x(), .dout_y()
+            );
+
+            reg signed [10:0] c_gx_d1, c_gy_d1;
+            always @(posedge clk or negedge rst_n) begin
+                if (!rst_n) begin
+                    c_gx_d1 <= 11'sd0;
+                    c_gy_d1 <= 11'sd0;
+                end else begin
+                    c_gx_d1 <= c_gx;
+                    c_gy_d1 <= c_gy;
+                end
+            end
+
+            wire [11:0] nms_grad;
+            wire        nms_valid;
+            if (CANNY_NMS_INTERP) begin : g_interp_nms
+                canny_nms_interp u_nms_c (
+                    .g00(n00), .g01(n01), .g02(n02),
+                    .g10(n10), .g11(n11), .g12(n12),
+                    .g20(n20), .g21(n21), .g22(n22),
+                    .gx(c_gx_d1), .gy(c_gy_d1),
+                    .in_valid(n_valid),
+                    .grad_out(nms_grad), .out_valid(nms_valid)
+                );
+            end else begin : g_sector_nms
+                canny_nms u_nms_c (
+                    .g00(n00), .g01(n01), .g02(n02),
+                    .g10(n10), .g11(n11), .g12(n12),
+                    .g20(n20), .g21(n21), .g22(n22),
+                    .gx(c_gx_d1), .gy(c_gy_d1),
+                    .in_valid(n_valid),
+                    .grad_out(nms_grad), .out_valid(nms_valid)
+                );
+            end
+
+            wire hyst_edge, hyst_valid;
+            canny_hysteresis #(.WIDTH(HYST_W)) u_hyst (
+                .clk(clk), .rst_n(rst_n),
+                .grad(nms_grad), .in_valid(nms_valid), .din_vsync(1'b0),
+                .high_thr(threshold), .low_thr(threshold >> 1),
+                .edge_out(hyst_edge), .out_valid(hyst_valid)
+            );
+
+            wire link_edge, link_valid;
+            if (LINK_EN) begin : g_link
+                edge_link3x3 #(.WIDTH(LINK_W)) u_link_c (
+                    .clk(clk), .rst_n(rst_n),
+                    .in_edge(hyst_edge), .in_valid(hyst_valid),
+                    .gx(c_gx_d1), .gy(c_gy_d1),
+                    .out_edge(link_edge), .out_valid(link_valid)
+                );
+                assign canny_path_data  = (link_valid && link_edge) ? 8'hFF : 8'h00;
+                assign canny_path_valid = link_valid;
+            end else begin : g_no_link
+                assign link_edge  = 1'b0;
+                assign link_valid = 1'b0;
+                assign canny_path_data  = (hyst_valid && hyst_edge) ? 8'hFF : 8'h00;
+                assign canny_path_valid = hyst_valid;
+            end
+        end else begin : g_no_canny
+            assign canny_path_data  = 8'h00;
+            assign canny_path_valid = 1'b0;
+        end
+    endgenerate
+
+    //--------------------------------------------------------------------------
+    // output timing delayed by exactly LATENCY cycles
+    //--------------------------------------------------------------------------
+    wire [7:0]        dly_data;
+    wire              dly_valid, dly_de, dly_hs, dly_vs;
+    wire [X_BITS-1:0] dly_x;
+    wire [Y_BITS-1:0] dly_y;
+
+    video_delay #(
+        .STAGES(LATENCY), .X_BITS(X_BITS), .Y_BITS(Y_BITS)
+    ) u_dly (
+        .clk(clk), .rst_n(rst_n),
+        .in_data(in_data), .in_valid(in_valid), .in_de(in_de),
+        .in_hs(in_hs), .in_vs(in_vs),
+        .in_x(in_x), .in_y(in_y),
+        .out_data(dly_data), .out_valid(dly_valid), .out_de(dly_de),
+        .out_hs(dly_hs), .out_vs(dly_vs),
+        .out_x(dly_x), .out_y(dly_y)
+    );
+
+    // binary edge image; blank outside the fully-valid region
+    assign out_data  = CANNY_EN ? canny_path_data : sob_path_data;
+    assign out_valid = CANNY_EN ? canny_path_valid : sob_path_valid;
+    assign out_de    = dly_de;
+    assign out_hs    = dly_hs;
+    assign out_vs    = dly_vs;
+    assign out_x     = (dly_x >= 11'd3) ? (dly_x - 11'd3) : {X_BITS{1'b0}};
+    assign out_y     = (dly_y >= 11'd3) ? (dly_y - 11'd3) : {Y_BITS{1'b0}};
+
+endmodule

--- a/system_dbg_top.v
+++ b/system_dbg_top.v
@@ -1,988 +1,998 @@
-//==============================================================================
-// system_dbg_top : camera-debug build of the system integration
-//                  version dbg_20260927_01  (2026-09-27)
-//
-//   Derivative of rtl/top/system_top.v (kept for reference / rollback).
-//   The datapath is identical, the differences are:
-//
-//     1. all 8 board LEDs (led0..led7) are used as a *fault bank* that says
-//        where the camera data path stopped (see DBG LED BANK below);
-//     2. the I2C master reports a sticky NACK flag (i2c_any_nack);
-//     3. the MIPI LP/HS polarity is selectable with two localparams
-//        (see MIPI POLARITY SWITCHES below);
-//     4. NEW in this version: the csi_rx soft IP gets its own 50 MHz clock
-//        (clk_csi) instead of clk_sys = 24 MHz - see CLOCKING below.
-//
-//   Everything downstream of `csi_valid` is unchanged, so a picture that
-//   works here works in proj/system as well.
-//
-//------------------------------------------------------------------------------
-// ALIGNED WITH THE BOARD VENDOR'S OWN SC2210 DEMO  (2026-09-27)
-//
-//   Reference: VF-Ti60F225_HDK_V2.1_20251009\
-//              07-FPGA_HDL_Image-2023.2\04-1_Ti60_SC2210_HDMI_1080P60
-//   (same board + same sensor; ships a built bitstream, so it is known good)
-//
-//     * MIPI data lanes stay on the vendor's pins - peri.xml:
-//         csi_rxc  = GPIOR_PN_17
-//         csi_rxd0 = GPIOR_PN_18     (NOT PN_15: the xlsx "MIPI_RX0" is a
-//         csi_rxd1 = GPIOR_PN_19      board net name, not the D-PHY
-//         csi_rxd2 = GPIOR_PN_15      block_def order used by the hard block)
-//         csi_rxd3 = GPIOR_PN_16
-//       static delay 17, is_fifo = false  -> same as the vendor demo.
-//     * polarity INV_HS=1 / SWAP_LP=1 = vendor's CSI_RXD_INV = 4'b1111
-//       ("data can be inverted with swapped LP data and flipped HS data").
-//     * the camera initialisation table is the vendor's own
-//       I2C_SC2210_19201080_4Lanes_Config.v, 266 writes, identical.
-//
-//   The vendor's demo does NOT use the Efinix csi2_rx IP - it uses its own
-//   MIPIRx4LaneFre block - so the IP has to be given a sane environment:
-//   both available references run the RX core clock at 96..100 MHz while
-//   this project used to run it at 24 MHz.
-//------------------------------------------------------------------------------
-// CLOCKING  (peri.xml sys_pll, VCO = 3000 MHz)
-//
-//     clk_sys       24.0 MHz   I2C master + housekeeping
-//     clk_pixel     25.0 MHz   video/display pipeline
-//     clk_pixel_10x 250  MHz   HDMI serializer
-//     clk_csi       50.0 MHz   csi_rx soft IP core clock  <-- new here
-//
-//   Reason: ip/csi_rx was generated with CLOCK_FREQ_MHZ = 50 (documented
-//   range 40..100 MHz) but was fed clk_sys = 24 MHz, i.e. below the minimum.
-//   The IP converts its LP timing constants with this number, so feeding a
-//   clock that matches the parameter is the parameter-consistent setting.
-//   If a future experiment shows the IP wants the references' 96..100 MHz,
-//   only the clk_csi out_divider in the peri.xml has to change (60 -> 30).
-//
-//   Domain split: csi_rx uses clk_csi for `clk`/`axi_clk`, csi_rxc_i (the
-//   D-PHY byte clock, ~31 MHz) for `clk_byte_HS`, and clk_pixel for the pixel
-//   side.  Everything downstream is still clk_pixel only.
-//------------------------------------------------------------------------------
-//
-// KEYS
-//   key_up : increase the Sobel threshold (as before).
-//   key_dn : short press cycles the display mode
-//              0 raw -> 1 grayscale -> 2 edge -> 3 split
-//              -> 4 red-edge overlay -> 0 ...
-//            hold 1 s toggles the LED fault/timing panel.
-//   Power-on mode is 3 (the legacy split view).
-//
-// NOTE ON THE CLOCK DOMAINS
-//   csi_rx already contains the byte-clock -> pixel-clock dual-clock FIFO, so
-//   everything downstream of csi_rx lives in clk_pixel.  The only remaining
-//   asynchronous inputs are the two push buttons, which are debounced
-//   directly in clk_pixel.
-//==============================================================================
-module system_dbg_top (
-    input  wire        clk_24m,          // 24 MHz crystal (PLL reference)
-    output wire        sys_pll_rstn_o,   // PLL reset, active low -> drive high
-    input  wire        sys_pll_lock,     // PLL locked
-    input  wire        clk_sys,          // PLL out : 24 MHz system clock
-    input  wire        clk_pixel,        // PLL out : 25.0 MHz pixel clock
-    input  wire        clk_pixel_10x,    // PLL out : 250 MHz serializer clock
-    input  wire        clk_csi,          // PLL out : 50 MHz csi_rx core clock
-
-    //------------------------------------------------------------------
-    // MIPI-CSI I2C
-    //------------------------------------------------------------------
-    output wire        csi_scl_o,
-    output wire        csi_scl_oe,
-    input  wire        csi_scl_i,
-    output wire        csi_sda_o,
-    output wire        csi_sda_oe,
-    input  wire        csi_sda_i,
-
-    //------------------------------------------------------------------
-    // MIPI-CSI RXC (clock lane)
-    //------------------------------------------------------------------
-    input  wire        csi_rxc_lp_p_i,
-    input  wire        csi_rxc_lp_n_i,
-    output wire        csi_rxc_hs_en_o,
-    output wire        csi_rxc_hs_term_en_o,
-    input  wire        csi_rxc_i,        // D-PHY RX byte clock (CLKOUT)
-
-    //------------------------------------------------------------------
-    // MIPI-CSI RXD0
-    //------------------------------------------------------------------
-    output wire        csi_rxd0_rst_o,
-    output wire        csi_rxd0_hs_en_o,
-    output wire        csi_rxd0_hs_term_en_o,
-    input  wire        csi_rxd0_lp_p_i,
-    input  wire        csi_rxd0_lp_n_i,
-    input  wire [7:0]  csi_rxd0_hs_i,
-
-    //------------------------------------------------------------------
-    // MIPI-CSI RXD1
-    //------------------------------------------------------------------
-    output wire        csi_rxd1_rst_o,
-    output wire        csi_rxd1_hs_en_o,
-    output wire        csi_rxd1_hs_term_en_o,
-    input  wire        csi_rxd1_lp_p_i,
-    input  wire        csi_rxd1_lp_n_i,
-    input  wire [7:0]  csi_rxd1_hs_i,
-
-    //------------------------------------------------------------------
-    // MIPI-CSI RXD2
-    //------------------------------------------------------------------
-    output wire        csi_rxd2_rst_o,
-    output wire        csi_rxd2_hs_en_o,
-    output wire        csi_rxd2_hs_term_en_o,
-    input  wire        csi_rxd2_lp_p_i,
-    input  wire        csi_rxd2_lp_n_i,
-    input  wire [7:0]  csi_rxd2_hs_i,
-
-    //------------------------------------------------------------------
-    // MIPI-CSI RXD3
-    //------------------------------------------------------------------
-    output wire        csi_rxd3_rst_o,
-    output wire        csi_rxd3_hs_en_o,
-    output wire        csi_rxd3_hs_term_en_o,
-    input  wire        csi_rxd3_lp_p_i,
-    input  wire        csi_rxd3_lp_n_i,
-    input  wire [7:0]  csi_rxd3_hs_i,
-
-    //------------------------------------------------------------------
-    // HDMI TMDS (10-bit parallel -> on-chip LVDS TX 10:1 serializer)
-    //------------------------------------------------------------------
-    output wire [9:0]  hdmi_txc_o,
-    output wire [9:0]  hdmi_txd0_o,
-    output wire [9:0]  hdmi_txd1_o,
-    output wire [9:0]  hdmi_txd2_o,
-    output wire        hdmi_txc_oe,
-    output wire        hdmi_txd0_oe,
-    output wire        hdmi_txd1_oe,
-    output wire        hdmi_txd2_oe,
-    output wire        hdmi_txc_rst_o,
-    output wire        hdmi_txd0_rst_o,
-    output wire        hdmi_txd1_rst_o,
-    output wire        hdmi_txd2_rst_o,
-
-    //------------------------------------------------------------------
-    // User IO : 2 keys + the 8 board LEDs
-    //------------------------------------------------------------------
-    input  wire        key_up,
-    input  wire        key_dn,
-    output wire [7:0]  led            // LED0..LED7, ACTIVE LOW (0 = lit)
-);
-
-    //--------------------------------------------------------------------------
-    // Latency of the algorithm branch.
-    //--------------------------------------------------------------------------
-    localparam ALG_LATENCY = 12;
-    localparam X_BITS      = 11;
-    localparam Y_BITS      = 11;
-
-    //--------------------------------------------------------------------------
-    // Full-resolution edge algorithm selector.
-    //   0 = original Sobel + NMS + local hysteresis (baseline, LATENCY 14)
-    //   1 = Canny : Gaussian -> Sobel -> NMS -> hysteresis -> linking (LATENCY 13)
-    // Rebuild with EDGE_ALGO=0 to fall back to the baseline bitstream for an
-    // on-the-bench A/B comparison.
-    //--------------------------------------------------------------------------
-    localparam EDGE_ALGO        = 1;
-    localparam ALG_LATENCY_FULL = (EDGE_ALGO == 1) ? 13 : 14;
-
-    //--------------------------------------------------------------------------
-    // MIPI POLARITY SWITCHES  (Debug.md 4.2 - "suspect #1")
-    //
-    //   The vendor example and rtl/camera/camera_top.v pass LP_P->LP_P,
-    //   LP_N->LP_N and the HS bytes un-inverted.  The old system_top.v passed
-    //   them swapped / inverted *without a comment*.  Both variants are
-    //   available here; only one can be right for this board.
-    //
-    //   Sweep order (change one letter, rebuild, watch LED3 + LED6):
-    //     INV_HS=1, SWAP_LP=1   <- default, identical to the old system_top.v
-    //     INV_HS=0, SWAP_LP=0   <- identical to the vendor example
-    //     INV_HS=1, SWAP_LP=0
-    //     INV_HS=0, SWAP_LP=1
-    //--------------------------------------------------------------------------
-    localparam INV_HS  = 1'b1;   // 1 = invert the received HS byte
-    localparam SWAP_LP = 1'b1;   // 1 = swap LP P/N
-
-    wire [7:0] hs0 = INV_HS ? (csi_rxd0_hs_i ^ 8'hff) : csi_rxd0_hs_i;
-    wire [7:0] hs1 = INV_HS ? (csi_rxd1_hs_i ^ 8'hff) : csi_rxd1_hs_i;
-    wire [7:0] hs2 = INV_HS ? (csi_rxd2_hs_i ^ 8'hff) : csi_rxd2_hs_i;
-    wire [7:0] hs3 = INV_HS ? (csi_rxd3_hs_i ^ 8'hff) : csi_rxd3_hs_i;
-
-    wire [3:0] lp_p = SWAP_LP ? {csi_rxd3_lp_n_i, csi_rxd2_lp_n_i,
-                                 csi_rxd1_lp_n_i, csi_rxd0_lp_n_i}
-                              : {csi_rxd3_lp_p_i, csi_rxd2_lp_p_i,
-                                 csi_rxd1_lp_p_i, csi_rxd0_lp_p_i};
-    wire [3:0] lp_n = SWAP_LP ? {csi_rxd3_lp_p_i, csi_rxd2_lp_p_i,
-                                 csi_rxd1_lp_p_i, csi_rxd0_lp_p_i}
-                              : {csi_rxd3_lp_n_i, csi_rxd2_lp_n_i,
-                                 csi_rxd1_lp_n_i, csi_rxd0_lp_n_i};
-
-    //--------------------------------------------------------------------------
-    // Reset
-    //--------------------------------------------------------------------------
-    assign sys_pll_rstn_o = 1'b1;
-
-    reg rst_n_pix;
-    always @(posedge clk_pixel or negedge sys_pll_lock) begin
-        if (!sys_pll_lock) rst_n_pix <= 1'b0;
-        else               rst_n_pix <= 1'b1;
-    end
-
-    wire rst_n_sys = sys_pll_lock;
-
-    //--------------------------------------------------------------------------
-    // I2C : SC2210 register LUT + master  (265 entries -> 9-bit index)
-    //--------------------------------------------------------------------------
-    wire [8:0]  i2c_index;
-    wire [23:0] i2c_lut;
-    wire [8:0]  i2c_size;
-    wire        i2c_done;
-    wire        i2c_nack;
-
-    // dbg_20260928_01: local 640x480 (VGA60) table - the sensor now outputs the
-    // 640x480 centre crop directly at 59.52 Hz / 31.25 kHz lines, so the display
-    // can show it 1:1 (see the file header for the register derivation).
-    I2C_SC2210_640x480_4Lanes_Config u_sc2210_cfg (
-        .LUT_INDEX(i2c_index),
-        .LUT_DATA (i2c_lut),
-        .LUT_SIZE (i2c_size)
-    );
-
-    i2c_timing_ctrl_16bit #(
-        .CLK_FREQ(24_000000),
-        .I2C_FREQ(400_000),
-        .IDX_W   (9)
-    ) u_i2c (
-        .clk             (clk_sys),
-        .rst_n           (rst_n_sys),
-        .i2c_sclk        (csi_scl_o),
-        .i2c_sdat_IN     (csi_sda_i),
-        .i2c_sdat_OUT    (csi_sda_o),
-        .i2c_sdat_OE     (csi_sda_oe),
-        .i2c_config_size (i2c_size),
-        .i2c_config_index(i2c_index),
-        .i2c_config_data ({8'h60, i2c_lut}),
-        .i2c_config_done (i2c_done),
-        .i2c_any_nack    (i2c_nack),
-        .i2c_rdata       ()
-    );
-    assign csi_scl_oe = 1'b1;          // SCL is always driven by the master
-
-    //--------------------------------------------------------------------------
-    // csi_rx soft IP (AXI tied off)
-    //--------------------------------------------------------------------------
-    wire        rxd0_fifo_rd, rxd1_fifo_rd, rxd2_fifo_rd, rxd3_fifo_rd;
-    wire        rxd0_fifo_empty = 1'b0;
-    wire        rxd1_fifo_empty = 1'b0;
-    wire        rxd2_fifo_empty = 1'b0;
-    wire        rxd3_fifo_empty = 1'b0;
-
-    wire        csi_valid;
-    wire [63:0] csi_data;
-    wire        csi_hsync;
-    wire        csi_vsync;
-    wire [15:0] csi_word_count;
-    wire [5:0]  csi_datatype;
-    wire        csi_irq;
-
-    csi_rx u_csi_rx (
-        .reset_n         (rst_n_sys),
-        .clk             (clk_csi),        // 50 MHz (was clk_sys = 24 MHz)
-        .reset_byte_HS_n (rst_n_sys),
-        .clk_byte_HS     (csi_rxc_i),
-        .reset_pixel_n   (rst_n_pix),
-        .clk_pixel       (clk_pixel),
-
-        .Rx_LP_CLK_P     (csi_rxc_lp_p_i),
-        .Rx_LP_CLK_N     (csi_rxc_lp_n_i),
-        .Rx_HS_enable_C  (csi_rxc_hs_en_o),
-        .LVDS_termen_C   (csi_rxc_hs_term_en_o),
-
-        .Rx_LP_D_P       (lp_p),
-        .Rx_LP_D_N       (lp_n),
-        .Rx_HS_D_0       (hs0),
-        .Rx_HS_D_1       (hs1),
-        .Rx_HS_D_2       (hs2),
-        .Rx_HS_D_3       (hs3),
-        .Rx_HS_D_4       (8'h00),
-        .Rx_HS_D_5       (8'h00),
-        .Rx_HS_D_6       (8'h00),
-        .Rx_HS_D_7       (8'h00),
-        .Rx_HS_enable_D  ({csi_rxd3_hs_en_o, csi_rxd2_hs_en_o,
-                           csi_rxd1_hs_en_o, csi_rxd0_hs_en_o}),
-        .LVDS_termen_D   ({csi_rxd3_hs_term_en_o, csi_rxd2_hs_term_en_o,
-                           csi_rxd1_hs_term_en_o, csi_rxd0_hs_term_en_o}),
-        .fifo_rd_enable  ({rxd3_fifo_rd, rxd2_fifo_rd,
-                           rxd1_fifo_rd, rxd0_fifo_rd}),
-        .fifo_rd_empty   ({rxd3_fifo_empty, rxd2_fifo_empty,
-                           rxd1_fifo_empty, rxd0_fifo_empty}),
-        .DLY_enable_D    (),
-        .DLY_inc_D       (),
-        .u_dly_enable_D  (4'b0000),
-        .u_dly_inc_D     (4'b0000),
-
-        .axi_clk         (clk_csi),
-        .axi_reset_n     (rst_n_sys),
-        .axi_awaddr      (6'b0),
-        .axi_awvalid     (1'b0),
-        .axi_awready     (),
-        .axi_wdata       (32'b0),
-        .axi_wvalid      (1'b0),
-        .axi_wready      (),
-        .axi_bvalid      (),
-        .axi_bready      (1'b0),
-        .axi_araddr      (6'b0),
-        .axi_arvalid     (1'b0),
-        .axi_arready     (),
-        .axi_rdata       (),
-        .axi_rvalid      (),
-        .axi_rready      (1'b1),
-
-        .vsync_vc0       (csi_vsync),
-        .vsync_vc1       (), .vsync_vc2(), .vsync_vc3(),
-        .vsync_vc4       (), .vsync_vc5(), .vsync_vc6(), .vsync_vc7(),
-        .vsync_vc8       (), .vsync_vc9(), .vsync_vc10(), .vsync_vc11(),
-        .vsync_vc12      (), .vsync_vc13(), .vsync_vc14(), .vsync_vc15(),
-        .hsync_vc0       (csi_hsync),
-        .hsync_vc1       (), .hsync_vc2(), .hsync_vc3(),
-        .hsync_vc4       (), .hsync_vc5(), .hsync_vc6(), .hsync_vc7(),
-        .hsync_vc8       (), .hsync_vc9(), .hsync_vc10(), .hsync_vc11(),
-        .hsync_vc12      (), .hsync_vc13(), .hsync_vc14(), .hsync_vc15(),
-        .vc              (),
-        .vcx             (),
-        .word_count      (csi_word_count),
-        .shortpkt_data_field(),
-        .datatype        (csi_datatype),
-        .pixel_per_clk   (),
-        .pixel_data      (csi_data),
-        .pixel_data_valid(csi_valid),
-        .irq             (csi_irq)
-    );
-
-    assign csi_rxd0_rst_o = ~rst_n_sys;
-    assign csi_rxd1_rst_o = ~rst_n_sys;
-    assign csi_rxd2_rst_o = ~rst_n_sys;
-    assign csi_rxd3_rst_o = ~rst_n_sys;
-
-    //--------------------------------------------------------------------------
-    // CSI packed stream -> frozen 640x480 pixel stream
-    //--------------------------------------------------------------------------
-    wire [7:0]  pix_r, pix_g, pix_b;
-    wire        pix_valid, pix_de, pix_hsync, pix_vsync;
-    wire [10:0] pix_x, pix_y, pix_hcnt, pix_y_act;
-    wire        line_late, capture_ovf;
-
-    //--------------------------------------------------------------------------
-    // dbg_20261012_03 : FRAME BUFFER instead of the 1-line ping-pong buffer.
-    //   A 320x240x8b frame (76.8 kB in block RAM) is filled from the camera and
-    //   read out by the display's own free-running 640x480@59.5 Hz timing, so
-    //   the picture position no longer depends on the camera's VTS/frame rate
-    //   at all - that is what finally removes the rolling (the sensor turned
-    //   out to be stuck at ~1112-line frames, i.e. ~28 fps, and refuses to be
-    //   programmed to 60 fps).
-    //   Same output interface as video_source, so everything downstream is
-    //   unchanged.  line_late / capture_ovf are tied low inside the module.
-    //--------------------------------------------------------------------------
-    wire        store_written;      // 1 = the frame buffer has been filled at least once
-
-    // The colour preview store is instantiated after camera_line_unpack (it
-    // needs the full-resolution pixel stream for debayering).
-
-    //--------------------------------------------------------------------------
-    // Full-resolution camera pixel stream (64-bit CSI beats -> 1 pixel/clk)
-    //--------------------------------------------------------------------------
-    wire [7:0]  cam_pix_data;
-    wire        cam_pix_valid, cam_pix_de, cam_pix_hs, cam_pix_vs;
-    wire [10:0] cam_pix_x, cam_pix_y;
-
-    camera_line_unpack u_cam_unpack (
-        .clk(clk_pixel), .rst_n(rst_n_pix),
-        .in_valid(csi_valid), .in_hs(csi_hsync), .in_vs(csi_vsync),
-        .in_data(csi_data),
-        .out_data(cam_pix_data), .out_valid(cam_pix_valid),
-        .out_de(cam_pix_de), .out_hs(cam_pix_hs), .out_vs(cam_pix_vs),
-        .out_x(cam_pix_x), .out_y(cam_pix_y)
-    );
-
-    //--------------------------------------------------------------------------
-    // Colour preview: full-res RAW -> 3x3 window -> debayer -> RGB332 store.
-    // The store has the same 320x240x8b footprint as the old RAW preview, so
-    // mode 0 becomes a colour image without spending extra memory blocks.
-    //--------------------------------------------------------------------------
-    wire [7:0] cb00, cb01, cb02, cb10, cb11, cb12, cb20, cb21, cb22;
-    wire       cb_valid;
-    wire [15:0] cb_x, cb_y;
-
-    line_buffer_3x3 #(.WIDTH(640), .DW(8)) u_cam_lb (
-        .clk(clk_pixel), .rst_n(rst_n_pix),
-        .din(cam_pix_data), .din_valid(cam_pix_valid), .din_vsync(~cam_pix_vs),
-        .w00(cb00), .w01(cb01), .w02(cb02),
-        .w10(cb10), .w11(cb11), .w12(cb12),
-        .w20(cb20), .w21(cb21), .w22(cb22),
-        .dout_valid(cb_valid), .dout_x(cb_x), .dout_y(cb_y)
-    );
-
-    wire [7:0] cam_r, cam_g, cam_b;
-    wire       cam_rgb_valid;
-    debayer u_cam_db (
-        .clk(clk_pixel), .rst_n(rst_n_pix),
-        .w00(cb00), .w01(cb01), .w02(cb02),
-        .w10(cb10), .w11(cb11), .w12(cb12),
-        .w20(cb20), .w21(cb21), .w22(cb22),
-        .in_valid(cb_valid), .in_x(cb_x), .in_y(cb_y),
-        .r(cam_r), .g(cam_g), .b(cam_b), .out_valid(cam_rgb_valid)
-    );
-
-    // line / frame activity aligned with the debayer output (lb 1 + debayer 1)
-    reg [1:0] cam_hs_d, cam_vs_d;
-    always @(posedge clk_pixel or negedge rst_n_pix) begin
-        if (!rst_n_pix) begin
-            cam_hs_d <= 2'd0;
-            cam_vs_d <= 2'd0;
-        end else begin
-            cam_hs_d <= {cam_hs_d[0], cam_pix_hs};
-            cam_vs_d <= {cam_vs_d[0], cam_pix_vs};
-        end
-    end
-
-    // White balance for the colour preview.  Tuned from on-board feedback:
-    // no WB -> green, R/B 1.5x -> slightly red.  New balance: R x1.25 and
-    // B x1.625 (G unchanged), which also reduces R-channel highlight clipping.
-    // The two gains are the tuning knobs: change the shifts here if needed.
-    wire [8:0] cam_r_wb9 = {1'b0, cam_r} + {2'b00, cam_r[7:2]};                    // 1.25x
-    wire [8:0] cam_b_wb9 = {1'b0, cam_b} + {2'b00, cam_b[7:1]} + {4'b0000, cam_b[7:3]}; // 1.625x
-    wire [7:0] cam_r_wb  = cam_r_wb9[8] ? 8'hFF : cam_r_wb9[7:0];
-    wire [7:0] cam_b_wb  = cam_b_wb9[8] ? 8'hFF : cam_b_wb9[7:0];
-
-    rgb565_preview_store #(
-        .H_ACTIVE(640), .H_FRONT(16), .H_SYNC(96), .H_BACK(48),
-        .V_ACTIVE(480), .V_FRONT(10), .V_SYNC(2), .V_BACK(33),
-        .BILINEAR_H(0), .SAT_EN(0)
-    ) u_color_store (
-        .clk(clk_pixel), .rst_n(rst_n_pix),
-        .in_r(cam_r_wb), .in_g(cam_g), .in_b(cam_b_wb), .in_valid(cam_rgb_valid),
