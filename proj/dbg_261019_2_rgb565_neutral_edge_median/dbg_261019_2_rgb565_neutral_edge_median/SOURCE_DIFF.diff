+    assign csi_rxd0_rst_o = ~rst_n_sys;
+    assign csi_rxd1_rst_o = ~rst_n_sys;
+    assign csi_rxd2_rst_o = ~rst_n_sys;
+    assign csi_rxd3_rst_o = ~rst_n_sys;
