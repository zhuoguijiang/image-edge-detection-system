--- a/scharr.v
+++ b/scharr.v
@@ -0,0 +1,100 @@
+`timescale 1ns / 1ps
+//==============================================================================
+// scharr : 3x3 Scharr gradient with the same output range/interface as sobel.
+//
+//   Gx = [3 0 -3; 10 0 -10; 3 0 -3] / 4
+//   Gy = [3 10 3; 0 0 0; -3 -10 -3] / 4
+//   grad = |Gx| + |Gy|
+//
+//   The 3/10/3 weights have better rotational symmetry than Sobel's 1/2/1,
+//   improving diagonal response and reducing direction jitter. Division by 4
+//   keeps the same 8-bit/Canny threshold scale and 11-bit direction range.
+//==============================================================================
+module scharr (
+    input  wire        clk,
+    input  wire        rst_n,
+    input  wire [7:0]  w00, w01, w02,
+    input  wire [7:0]  w10, w11, w12,
+    input  wire [7:0]  w20, w21, w22,
+    input  wire        in_valid,
+    input  wire [11:0] threshold,
+    output reg  [11:0] grad,
+    output reg signed [10:0] gx,
+    output reg signed [10:0] gy,
+    output reg         edge_out,
+    output reg         out_valid
+);
+
+    // stage 1: 3/10/3 weighted column and row sums (max 4080)
+    reg [11:0] s1_col_r, s1_col_l, s1_row_b, s1_row_t;
+    reg        s1_valid;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            s1_col_r <= 12'd0; s1_col_l <= 12'd0;
+            s1_row_b <= 12'd0; s1_row_t <= 12'd0;
+            s1_valid <= 1'b0;
+        end else begin
+            s1_col_r <= ({4'b0000, w02} << 1) + {4'b0000, w02} +
+                        ({4'b0000, w12} << 3) + ({4'b0000, w12} << 1) +
+                        ({4'b0000, w22} << 1) + {4'b0000, w22};
+            s1_col_l <= ({4'b0000, w00} << 1) + {4'b0000, w00} +
+                        ({4'b0000, w10} << 3) + ({4'b0000, w10} << 1) +
+                        ({4'b0000, w20} << 1) + {4'b0000, w20};
+            s1_row_b <= ({4'b0000, w20} << 1) + {4'b0000, w20} +
+                        ({4'b0000, w21} << 3) + ({4'b0000, w21} << 1) +
+                        ({4'b0000, w22} << 1) + {4'b0000, w22};
+            s1_row_t <= ({4'b0000, w00} << 1) + {4'b0000, w00} +
+                        ({4'b0000, w01} << 3) + ({4'b0000, w01} << 1) +
+                        ({4'b0000, w02} << 1) + {4'b0000, w02};
+            s1_valid <= in_valid;
+        end
+    end
+
+    // stage 2: full-scale signed gradients
+    reg signed [12:0] s2_gx, s2_gy;
+    reg               s2_valid;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            s2_gx <= 13'sd0; s2_gy <= 13'sd0; s2_valid <= 1'b0;
+        end else begin
+            s2_gx <= $signed({1'b0, s1_col_r}) - $signed({1'b0, s1_col_l});
+            s2_gy <= $signed({1'b0, s1_row_b}) - $signed({1'b0, s1_row_t});
+            s2_valid <= s1_valid;
+        end
+    end
+
+    // stage 3: divide by 4 and compute L1 magnitude
+    reg signed [10:0] s3_gx, s3_gy;
+    reg [11:0]        s3_grad;
+    reg               s3_valid;
+    wire signed [10:0] gx_q = s2_gx >>> 2;
+    wire signed [10:0] gy_q = s2_gy >>> 2;
+    wire [10:0] agx = gx_q[10] ? (~gx_q + 11'd1) : gx_q;
+    wire [10:0] agy = gy_q[10] ? (~gy_q + 11'd1) : gy_q;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            s3_gx <= 11'sd0; s3_gy <= 11'sd0;
+            s3_grad <= 12'd0; s3_valid <= 1'b0;
+        end else begin
+            s3_gx <= gx_q;
+            s3_gy <= gy_q;
+            s3_grad <= {1'b0, agx} + {1'b0, agy};
+            s3_valid <= s2_valid;
+        end
+    end
+
+    // stage 4: threshold / output
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            grad <= 12'd0; gx <= 11'sd0; gy <= 11'sd0;
+            edge_out <= 1'b0; out_valid <= 1'b0;
+        end else begin
+            grad      <= s3_grad;
+            gx        <= s3_gx;
+            gy        <= s3_gy;
+            edge_out  <= s3_valid && (s3_grad >= threshold);
+            out_valid <= s3_valid;
+        end
+    end
+
+endmodule

--- a/gaussian3x3.v
+++ b/gaussian3x3.v
@@ -0,0 +1,48 @@
+`timescale 1ns / 1ps
+//==============================================================================
+// gaussian3x3 : optional second smoothing pass after gaussian5x5.
+// Kernel = [1 2 1]^T x [1 2 1] / 16.
+//==============================================================================
+module gaussian3x3 #(
+    parameter WIDTH = 636,
+    parameter DW = 8
+)(
+    input  wire          clk,
+    input  wire          rst_n,
+    input  wire [DW-1:0] din,
+    input  wire          din_valid,
+    input  wire          din_vsync,
+    output reg  [DW-1:0] dout,
+    output reg           dout_valid
+);
+
+    wire [DW-1:0] w00, w01, w02, w10, w11, w12, w20, w21, w22;
+    wire win_valid;
+
+    line_buffer_3x3 #(.WIDTH(WIDTH), .DW(DW)) u_lb (
+        .clk(clk), .rst_n(rst_n),
+        .din(din), .din_valid(din_valid), .din_vsync(din_vsync),
+        .w00(w00), .w01(w01), .w02(w02),
+        .w10(w10), .w11(w11), .w12(w12),
+        .w20(w20), .w21(w21), .w22(w22),
+        .dout_valid(win_valid), .dout_x(), .dout_y()
+    );
+
+    wire [11:0] corners = {4'b0000, w00} + {4'b0000, w02} +
+                          {4'b0000, w20} + {4'b0000, w22};
+    wire [11:0] edges2  = {3'b000, w01, 1'b0} + {3'b000, w10, 1'b0} +
+                          {3'b000, w12, 1'b0} + {3'b000, w21, 1'b0};
+    wire [11:0] centre4 = {2'b00, w11, 2'b00};
+    wire [11:0] gsum = corners + edges2 + centre4;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            dout <= {DW{1'b0}};
+            dout_valid <= 1'b0;
+        end else begin
+            dout <= (gsum + 12'd8) >> 4;
+            dout_valid <= win_valid;
+        end
+    end
+
+endmodule

--- a/canny_nms_interp.v
+++ b/canny_nms_interp.v
@@ -0,0 +1,84 @@
+`timescale 1ns / 1ps
+//==============================================================================
+// canny_nms_interp : direction-interpolated non-maximum suppression.
+//
+// The old canny_nms quantised every gradient into four sectors. This version
+// blends the cardinal and diagonal neighbours in eight ratio bands, so shallow
+// diagonals compare against a value on the actual gradient direction. The
+// output remains a 1-pixel ridge and uses no division or frame buffer.
+//==============================================================================
+module canny_nms_interp #(
+    parameter DW = 12
+)(
+    input  wire [DW-1:0]      g00, g01, g02,
+    input  wire [DW-1:0]      g10, g11, g12,
+    input  wire [DW-1:0]      g20, g21, g22,
+    input  wire signed [10:0] gx,
+    input  wire signed [10:0] gy,
+    input  wire               in_valid,
+    output wire [DW-1:0]      grad_out,
+    output wire               out_valid
+);
+
+    wire [10:0] ax = gx[10] ? (~gx + 11'd1) : gx;
+    wire [10:0] ay = gy[10] ? (~gy + 11'd1) : gy;
+
+    // Eight ratio bands. mix=0 is a cardinal neighbour, mix=8 a diagonal.
+    reg [3:0] mix;
+    always @(*) begin
+        if (ax >= ay) begin
+            if      (({2'b00, ay} << 2) <= {2'b00, ax})      mix = 4'd0;
+            else if (({2'b00, ay} << 1) <= {2'b00, ax})      mix = 4'd2;
+            else if (({2'b00, ay} + {2'b00, ay} + {2'b00, ay}) <=
+                     ({2'b00, ax} << 1))                     mix = 4'd4;
+            else if (({2'b00, ay} << 2) <=
+                     ({2'b00, ax} + ({2'b00, ax} << 1)))     mix = 4'd6;
+            else                                              mix = 4'd8;
+        end else begin
+            if      (({2'b00, ax} << 2) <= {2'b00, ay})      mix = 4'd0;
+            else if (({2'b00, ax} << 1) <= {2'b00, ay})      mix = 4'd2;
+            else if (({2'b00, ax} + {2'b00, ax} + {2'b00, ax}) <=
+                     ({2'b00, ay} << 1))                     mix = 4'd4;
+            else if (({2'b00, ax} << 2) <=
+                     ({2'b00, ay} + ({2'b00, ay} << 1)))     mix = 4'd6;
+            else                                              mix = 4'd8;
+        end
+    end
+
+    reg [DW-1:0] prev_card, prev_diag, next_card, next_diag;
+    always @(*) begin
+        if (ax >= ay) begin
+            prev_card = g10;
+            next_card = g12;
+            if (gy[10]) begin
+                prev_diag = g20;
+                next_diag = g02;
+            end else begin
+                prev_diag = g00;
+                next_diag = g22;
+            end
+        end else begin
+            prev_card = g01;
+            next_card = g21;
+            if (gx[10]) begin
+                prev_diag = g02;
+                next_diag = g20;
+            end else begin
+                prev_diag = g00;
+                next_diag = g22;
+            end
+        end
+    end
+
+    wire [DW+3:0] prev_mix =
+        (prev_card * (8 - mix) + prev_diag * mix + 4) >> 3;
+    wire [DW+3:0] next_mix =
+        (next_card * (8 - mix) + next_diag * mix + 4) >> 3;
+    wire [DW+3:0] g11x = {{4{1'b0}}, g11};
+
+    wire nms_ok = (g11x >= prev_mix) && (g11x > next_mix);
+
+    assign grad_out  = nms_ok ? g11 : {DW{1'b0}};
+    assign out_valid = in_valid;
+
+endmodule

