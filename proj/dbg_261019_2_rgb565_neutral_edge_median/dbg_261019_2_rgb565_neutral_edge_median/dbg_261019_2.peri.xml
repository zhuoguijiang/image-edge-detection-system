    <efxpt:pll_info>
        <!-- ================================================================
             VCO = 24 MHz x 125 = 3000 MHz, so out_divider N gives 3000/N:

               clk_sys       125 -> 24.0 MHz   I2C master (CLK_FREQ=24 MHz)
               clk_pixel     120 -> 25.0 MHz   display / video pipeline
               clk_pixel_10x  12 -> 250  MHz   HDMI 10:1 serializer
               clk_csi        60 -> 50.0 MHz   csi_rx soft IP (was on 24 MHz)

             WHY clk_csi EXISTS (2026-09-27)
               The Efinix csi2_rx IP in ip/csi_rx was generated with
               CLOCK_FREQ_MHZ = 50, i.e. it expects a 40..100 MHz core clock,
               but this design used to feed it clk_sys = 24 MHz - below the
               documented minimum.  Both working references run the RX core
               clock at 96..100 MHz.  Feeding the IP a clock that matches its
               own parameter is the minimal, parameter-consistent fix.
               ================================================================ -->
        <efxpt:pll name="sys_pll" pll_def="PLL_TL0" ref_clock_name="" ref_clock_freq="24.0000" multiplier="1" pre_divider="1" post_divider="1" reset_name="sys_pll_rstn_o" locked_name="sys_pll_lock" is_ipfrz="false" is_bypass_lock="true">
            <efxpt:adv_prop ref_clock_mode="external" ref_clock1_name="" ext_ref_clock_id="4" clksel_name="" feedback_clock_name="clk_sys" feedback_mode="core"/>
            <efxpt:comp_output_clock name="clk_sys" number="0" out_divider="125" is_dyn_phase="false" phase_setting="0"/>
            <efxpt:comp_output_clock name="clk_pixel" number="1" out_divider="120" is_dyn_phase="false" phase_setting="0"/>
            <efxpt:comp_output_clock name="clk_pixel_10x" number="2" out_divider="12" is_dyn_phase="false" phase_setting="2"/>
            <efxpt:comp_output_clock name="clk_csi" number="3" out_divider="60" is_dyn_phase="false" phase_setting="0"/>
        </efxpt:pll>
    </efxpt:pll_info>
